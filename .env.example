# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── Nexus ──────────────────────────────────────────────────────────────────
# Get both from https://frc.nexus/api after registering webhooks
NEXUS_TOKEN=your-nexus-webhook-verification-token
NEXUS_API_KEY=your-nexus-api-key
NEXUS_EVENT_KEY=2026cancmp

# ── The Blue Alliance ───────────────────────────────────────────────────────
# Free key at https://www.thebluealliance.com/account
TBA_API_KEY=your-tba-api-key
TBA_EVENT_KEY=2026cancmp

# ── Scouting Lead ───────────────────────────────────────────────────────────
# Slack User ID (Profile → ⋮ → Copy Member ID)
SCOUTING_LEAD_SLACK_ID=U0000000000

# ── Google Sheets ───────────────────────────────────────────────────────────
# From the Google Sheet URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-spreadsheet-id
SHEET_NAME=Detailed Shifts
# Full JSON content of your service account key file (single line or multiline)
SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"pushbot@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Timing ──────────────────────────────────────────────────────────────────
CONFIRM_WAIT_MINUTES=7
ESCALATE_WAIT_MINUTES=4
TBA_POLL_INTERVAL_SECONDS=30

# ── Scout Slack IDs ─────────────────────────────────────────────────────────
# Format: Name=SlackUserID,Name=SlackUserID,...
# Slack User ID: ask scouts to go Profile → ⋮ → Copy Member ID
SCOUT_IDS=Kaveesh=U111,Vedant=U222,Neel=U333,Aryan K=U444,Damodar=U555,Niraj=U666,Aarav A=U777,Jasmine=U888,Mayukh=U999,Bryan=U000001,Pranith=U000002,Azaan=U000003,Dhruveen=U000004,Max=U000005,Noah=U000006,Abdullah=U000007,Ethan=U000008,Taylor=U000009,Pradyun=U000010

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
